# Copy to .env (which is gitignored) and fill in. Nothing here is a real key.
ANTHROPIC_API_KEY=
# The model to use for the agent. No default on purpose: you choose.
ANTHROPIC_MODEL=

# Model comparison only: the second model (the first is ANTHROPIC_MODEL). See docs/OBSERVABILITY.md.
ANTHROPIC_COMPARE_MODEL=
# Evals only: the grader model. It must differ from ANTHROPIC_MODEL (see docs/EVALS.md).
ANTHROPIC_JUDGE_MODEL=

# Optional
JOBSHOP_SOLVE_SECONDS=30
JOBSHOP_MAX_STEPS=12
JOBSHOP_MAX_TOKENS=200000
# Cost budget needs both prices (USD per million tokens) for your chosen model.
JOBSHOP_PRICE_INPUT_PER_MTOK=
JOBSHOP_PRICE_OUTPUT_PER_MTOK=
JOBSHOP_MAX_COST_USD=

# Plant documents (see docs/DESIGN.md). Both are optional.
# Folder of .md documents the assistant can search; "off" disables it. Defaults to ./knowledge for chat and web.
JOBSHOP_KNOWLEDGE_DIR=
# How they are searched: bm25 (default, nothing to install), dense (by meaning) or hybrid.
# dense and hybrid need:  uv sync --extra embeddings   (downloads a ~65 MB model from Hugging Face on first use)
JOBSHOP_RETRIEVER=

# Memory (see docs/DESIGN.md). Both optional.
# Where the planner's standing preferences are kept; "off" keeps them in memory only. Default ~/.jobshop/preferences.json
JOBSHOP_MEMORY=
# When the conversation's estimated size passes this many tokens, old tool results are cleared (default 40000).
JOBSHOP_HISTORY_TOKENS=

# Agent pattern: react (default), plan, verify, reflect, or several joined with + (e.g. plan+verify). See docs/DESIGN.md.
JOBSHOP_PATTERN=

# Multi-agent routing (pattern "route"): a smaller, cheaper model for the triage call. Empty = the main model.
# If you set prices above, a separate triage model needs its own prices (USD per million tokens).
JOBSHOP_TRIAGE_MODEL=
JOBSHOP_TRIAGE_PRICE_INPUT_PER_MTOK=
JOBSHOP_TRIAGE_PRICE_OUTPUT_PER_MTOK=

# Open models through Ollama (see docs/DESIGN.md). Name a model "ollama:<name>" in ANTHROPIC_MODEL, JOBSHOP_TRIAGE_MODEL,
# --model or --judge-model; no Anthropic key is needed if every model in the run is an ollama: one. Not yet tried on a real Ollama.
JOBSHOP_OLLAMA_URL=http://127.0.0.1:11434
# Context window requested from Ollama (it silently cuts a prompt that does not fit; the adapter refuses such a reply).
JOBSHOP_OLLAMA_NUM_CTX=16384
JOBSHOP_OLLAMA_TIMEOUT_S=300

# Web app: how many agent turns it will start per minute and per hour (0 = no limit). Protects the model budget.
JOBSHOP_RATE_LIMIT_PER_MIN=10
JOBSHOP_RATE_LIMIT_PER_HOUR=120
